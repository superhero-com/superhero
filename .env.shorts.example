ENABLE_SHORTS=false
# Build-time public URLs only; never put service keys in VITE_ variables.
VITE_SHORTS_API_URL=https://staging-api.example.com
VITE_SHORTS_STREAM_URL=https://video.example.com

# Public SHA-256 of the reviewed normalized release manifest; required for wallet actions.
# Obtain from the API release guide, independently of the public /config endpoint.
VITE_SHORTS_RELEASE_HASH=
