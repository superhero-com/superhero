{
  "name": "superhero",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node ./scripts/generate-sitemap.cjs && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest",
    "test:e2e:host": "playwright test",
    "test:e2e:screenshots": "playwright test e2e/screenshots.spec.ts",
    "test:e2e:csp": "playwright test --config playwright.csp.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:host:update-snapshots": "playwright test --update-snapshots",
    "test:e2e": "docker build -f Dockerfile.e2e -t superhero-e2e . && docker run --rm --ipc=host --init superhero-e2e",
    "test:e2e:update-snapshots": "docker build -f Dockerfile.e2e -t superhero-e2e . && docker run --rm --ipc=host --init -v \"$(pwd)/e2e:/app/e2e\" superhero-e2e npm run test:e2e:host:update-snapshots",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "generate:api": "openapi --input http://localhost:3000/api-json --output ./src/api/generated --useOptions",
    "generate:sitemap": "ts-node ./scripts/generate-sitemap.ts",
    "generate:pwa-icons": "node ./scripts/generate-pwa-icons.cjs",
    "verify:pwa-assets": "node ./scripts/verify-pwa-assets.cjs",
    "check:csp-origins": "node ./scripts/check-csp-origins.cjs",
    "release": "standard-version",
    "postinstall": "node ./scripts/update-package-type.cjs"
  },
  "dependencies": {
    "@aeternity/aepp-calldata": "^1.9.1",
    "@aeternity/aepp-sdk": "^14.1.0",
    "@ethersproject/bignumber": "^5.8.0",
    "@multiavatar/multiavatar": "^1.0.7",
    "@noble/hashes": "^2.3.0",
    "@noble/secp256k1": "^1.7.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reown/appkit": "^1.8.8",
    "@reown/appkit-adapter-ethers": "^1.8.8",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.3.0",
    "@tanstack/react-query": "^5.85.5",
    "@visx/wordcloud": "^4.0.0",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bctsl-contracts": "git+https://git@github.com/bctsl/bctsl-contracts#02e5dc1acb31729b7f0e4c2c72bcd9e381c9d9dc",
    "bctsl-sdk": "git+https://git@github.com/bctsl/bctsl-sdk#v1.0.0",
    "bignumber.js": "^9.3.1",
    "camelcase-keys-deep": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dex-contracts-v2": "git+https://git@github.com/aeternity/dex-contracts-v2#69f800fece02da1444af7f0d6622fec356a15496",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "ethers": "^6.13.2",
    "express": "^5.2.1",
    "i18next": "^26.4.0",
    "jdenticon": "^3.3.0",
    "jotai": "^2.13.1",
    "katex": "^0.18.4",
    "lightweight-charts": "^5.0.7",
    "lucide-react": "^1.33.0",
    "moment": "^2.30.1",
    "nostr-tools": "^2.24.1",
    "qrcode": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.4.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "tipping-contract": "git+https://git@github.com/aeternity/tipping-contract#v5.0.0-alpha2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "postcss": "^8.5.6",
    "sass": "^1.77.6",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.2"
  },
  "overrides": {
    "argon2": "^0.43.0",
    "@types/node": "^24.10.1",
    "eslint-config-airbnb": {
      "eslint": "$eslint",
      "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks"
    }
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "section": "Maintenance"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "style",
        "section": "Style"
      },
      {
        "type": "refactor",
        "section": "Maintenance"
      },
      {
        "type": "build",
        "section": "Maintenance"
      },
      {
        "type": "ci",
        "section": "Maintenance"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  }
}
